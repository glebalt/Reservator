<UserControl x:Class="WpfApp1.Views.MakeReservation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp1.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
       
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />

        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource Header}" Text="Make reservation" />

        <Grid Grid.Row ="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Username" />
            <TextBox Grid.Row="1" Margin="0 20 0 0" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

        </Grid>

        <Grid Grid.Row ="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"   SharedSizeGroup="FirstRow"/>
                <RowDefinition Height="auto"   SharedSizeGroup="SecondRow" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" SharedSizeGroup="FirstColumn"/>
                <ColumnDefinition Width="auto" SharedSizeGroup="SecondColumn"/>
            </Grid.ColumnDefinitions>

            <TextBlock 
         Grid.Row="0"
         Grid.Column="0"
            Margin="0 50 0 0"
         Text="Floor number"/>
            <TextBox 
         Grid.Row="1"
         Grid.Column="0"
         Margin="0 5 0 0"
         Text="{Binding FloorNumber, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock 
         Grid.Row="0"
         Grid.Column="1"
          Margin="10 50 0 0"
         Text="Room number"/>
            <TextBox 
         Grid.Row="1"
         Grid.Column="1"
         Margin="10 5 0 0"
         Text="{Binding RoomNumber, UpdateSourceTrigger=PropertyChanged}"/>

        </Grid>

        <Grid Grid.Row ="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"  SharedSizeGroup="FirstColumn" />
                <ColumnDefinition Width="auto" SharedSizeGroup="SecondColumn"/>
            </Grid.ColumnDefinitions>

            <TextBlock 
         Grid.Row="0"
         Grid.Column="0"
          Margin="0 50 0 0"
         Text="Start Date"/>
            <DatePicker 
         Grid.Row="1"
         Grid.Column="0"
         Margin="0 5 0 0"
         SelectedDate="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock 
         Grid.Row="0"
         Grid.Column="1"
         Margin="0 30 0 0"
         Text="End Date"/>
            <DatePicker 
         Grid.Row="1"
         Grid.Column="1"
         Margin="10 5 0 0"
         SelectedDate="{Binding EndDate, UpdateSourceTrigger=PropertyChanged}"/>

        </Grid>
        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button Content="Submit" Margin="0 50 0 0" Command="{Binding SubmitCommand}" />
            <Button Margin="20 50 0 0" Content="Cancel"  Command="{Binding CancelCommand}" />
         
        </StackPanel>



        <Grid Grid.Row="5" Grid.Column="1">

           

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"  SharedSizeGroup="FirstColumn" />
                <ColumnDefinition Width="auto" SharedSizeGroup="SecondColumn"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
            <Button  Grid.Row ="1"
             Content="AsyncButton"
             Margin="0 20 0 0" 
             Width="100" 
             Command="{Binding TestAsyncCommand}" 
             BorderBrush ="LightGray"
             FontWeight="Bold"
             FontFamily="Trebuchet MS"
             HorizontalAlignment="Right" RenderTransformOrigin="0.5,0.5" >             
            
              
            </Button>
            </StackPanel>
        </Grid>
         
     

        </Grid>
    
</UserControl>
